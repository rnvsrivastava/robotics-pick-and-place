<?xml version="1.0"?>
<robot name="learning_arm">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <cylinder radius="0.08" length="0.12"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06"/>
      <geometry>
        <cylinder radius="0.08" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="1.0"/>
      <inertia ixx="0.0028" ixy="0" ixz="0"
               iyy="0.0028" iyz="0" izz="0.0032"/>
    </inertial>
  </link>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.35"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0" rpy="0 1.5708 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.005257" ixy="0" ixz="0"
               iyy="0.005257" iyz="0" izz="0.000306"/>
    </inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

 <link name="forearm_link">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.30"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.35 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.002704" ixy="0" ixz="0"
               iyy="0.002704" iyz="0" izz="0.000158"/>
    </inertial>
 </link>

  <joint name="elbow_joint" type="revolute">
        <parent link="upper_arm_link"/>
        <child link="forearm_link"/>
        <origin xyz="0.35 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0" upper="2.0" effort="8" velocity="1.0"/>
  </joint>
 <link name="gripper_base_link">
    <visual>
        <origin xyz="0.04 0 0"/>
        <geometry>
        <box size="0.08 0.12 0.04"/>
        </geometry>
        <material name="gripper_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
        </material>
    </visual>
 </link>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0.30 0 0"/>
  </joint>

 <link name="left_finger_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.02 0.04"/>
      </geometry>
      <material name="finger_blue">
        <color rgba="0.1 0.3 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.02 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000083" ixy="0" ixz="0"
               iyy="0.0000483" iyz="0" izz="0.0000433"/>
    </inertial>
 </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.08 0.05 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.03" effort="5" velocity="0.05"/>
  </joint>

 <link name="right_finger_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.02 0.04"/>
      </geometry>
      <material name="finger_orange">
        <color rgba="0.9 0.35 0.05 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.02 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000083" ixy="0" ixz="0"
               iyy="0.0000483" iyz="0" izz="0.0000433"/>
    </inertial>
 </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.08 -0.05 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.03" effort="5" velocity="0.05"/>
  </joint>
</robot>