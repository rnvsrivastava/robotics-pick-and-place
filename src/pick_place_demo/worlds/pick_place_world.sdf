<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_place_world">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

        <!-- A movable 5 cm block, resting on the ground -->
    <model name="red_block">
      <pose>0.55 0 0.025 0 0 0</pose>
      <link name="block_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00002083</ixx>
            <iyy>0.00002083</iyy>
            <izz>0.00002083</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="block_collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.9 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A fixed tray with a base and four walls -->
    <model name="blue_tray">
      <static>true</static>
      <pose>0.78 0 0 0 0 0</pose>
      <link name="tray_link">
        <collision name="tray_base_collision">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.20 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="tray_base_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>0.24 0.20 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.1 0.7 1</ambient>
            <diffuse>0.05 0.15 0.9 1</diffuse>
          </material>
        </visual>

        <collision name="tray_left_wall_collision">
          <pose>0 0.09 0.06 0 0 0</pose>
          <geometry><box><size>0.24 0.02 0.08</size></box></geometry>
        </collision>
        <visual name="tray_left_wall_visual">
          <pose>0 0.09 0.06 0 0 0</pose>
          <geometry><box><size>0.24 0.02 0.08</size></box></geometry>
          <material><ambient>0.05 0.1 0.7 1</ambient><diffuse>0.05 0.15 0.9 1</diffuse></material>
        </visual>

        <collision name="tray_right_wall_collision">
          <pose>0 -0.09 0.06 0 0 0</pose>
          <geometry><box><size>0.24 0.02 0.08</size></box></geometry>
        </collision>
        <visual name="tray_right_wall_visual">
          <pose>0 -0.09 0.06 0 0 0</pose>
          <geometry><box><size>0.24 0.02 0.08</size></box></geometry>
          <material><ambient>0.05 0.1 0.7 1</ambient><diffuse>0.05 0.15 0.9 1</diffuse></material>
        </visual>

        <collision name="tray_front_wall_collision">
          <pose>0.11 0 0.06 0 0 0</pose>
          <geometry><box><size>0.02 0.20 0.08</size></box></geometry>
        </collision>
        <visual name="tray_front_wall_visual">
          <pose>0.11 0 0.06 0 0 0</pose>
          <geometry><box><size>0.02 0.20 0.08</size></box></geometry>
          <material><ambient>0.05 0.1 0.7 1</ambient><diffuse>0.05 0.15 0.9 1</diffuse></material>
        </visual>

        <collision name="tray_back_wall_collision">
          <pose>-0.11 0 0.06 0 0 0</pose>
          <geometry><box><size>0.02 0.20 0.08</size></box></geometry>
        </collision>
        <visual name="tray_back_wall_visual">
          <pose>-0.11 0 0.06 0 0 0</pose>
          <geometry><box><size>0.02 0.20 0.08</size></box></geometry>
          <material><ambient>0.05 0.1 0.7 1</ambient><diffuse>0.05 0.15 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>